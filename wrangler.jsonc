{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nairaleap-canary",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "NAIRALEAP_DB",
      "database_name": "nairaleap-staging-data",
      "database_id": "b3026198-6d98-4036-a023-d151a81a3fcb",
      "migrations_dir": "cloudflare/migrations"
    }
  ]
}
