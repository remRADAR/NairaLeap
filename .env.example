# Supabase project settings from the project Connect panel
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional public WordPress REST posts endpoint. The local editorial snapshot is used when unset.
VITE_WORDPRESS_API_URL=https://your-wordpress-site.example/wp-json/wp/v2/posts
# Optional durable editorial media base URL (future Cloudflare R2 bucket or CDN).
# When set, local /editorial/... media paths resolve from this base. Leave unset to
# serve media from the application deployment filesystem.
VITE_EDITORIAL_MEDIA_BASE_URL=
# Optional KeyPay public key. Keep gateway pass and secret credentials out of the frontend.
VITE_KEYPAY_PUBLIC_KEY=your-keypay-public-key
